<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Version>0.1.2</Version>
    <!-- The name Windows shows: Task Manager, the startup apps, the file's properties. -->
    <Product>Blade Control</Product>
    <AssemblyTitle>Blade Control</AssemblyTitle>
    <Company>Blade Control</Company>
    <!-- Run on a newer .NET too if 10 is not installed. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Small heaps over speed: the app spends most of its time waiting in the tray. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ApplicationIcon>Assets\BladeControl.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!--
    The portable build: a folder that runs on any 64-bit Windows 10 or 11,
    with .NET inside the exe, nothing to install. WPF's few native DLLs sit
    beside the exe, so nothing is unpacked into the temporary folder to run:
    dotnet publish src/BladeControl -c Release -p:Portable=true -o dist
  -->
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- WPF names win: Windows Forms and System.Drawing are only used by name, in the tray icon. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The collector works harder to keep the heap compact (0 to 9). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BladeControl.Core\BladeControl.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\BladeControl.ico" />
    <!-- The logo in the title bar. -->
    <Resource Include="Assets\Logo.png" />
    <!-- Titillium Web, inside the exe: nothing is installed in Windows. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- The laptops' pictures for the device panel, by model (see LaptopPictureNames). -->
    <Resource Include="Assets\Laptops\*.png" />
    <!-- Its license (SIL OFL 1.1) travels beside the exe, as the license asks. -->
    <None Include="Assets\Fonts\OFL.txt" Link="TitilliumWeb-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
