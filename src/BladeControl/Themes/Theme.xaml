<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The palette and type, in one place. The look follows the Synapse-style
        concept: a near-black window, darker cards, flat dark tiles, and the
        green accent for whatever is chosen.
    -->

    <!-- Colors. -->
    <Color x:Key="Color.Window">#FF202020</Color>
    <Color x:Key="Color.WindowTop">#FF242424</Color>
    <Color x:Key="Color.Card">#FF1A1A1A</Color>
    <Color x:Key="Color.CardTop">#FF1D1D1D</Color>
    <Color x:Key="Color.Tile">#FF262626</Color>
    <Color x:Key="Color.TileHover">#FF2E2E2E</Color>
    <Color x:Key="Color.TilePressed">#FF333333</Color>
    <Color x:Key="Color.Line">#FF2C2C2C</Color>
    <Color x:Key="Color.Track">#FF3A3A3A</Color>
    <Color x:Key="Color.Accent">#FF44D62C</Color>
    <Color x:Key="Color.AccentHover">#FF55E03D</Color>
    <Color x:Key="Color.AccentDim">#FF1F3A1A</Color>
    <Color x:Key="Color.OnAccent">#FF0C0C0C</Color>
    <Color x:Key="Color.Text">#FFF2F2F2</Color>
    <Color x:Key="Color.TextSoft">#FFC8C8C8</Color>
    <Color x:Key="Color.TextMuted">#FF8C8C8C</Color>
    <Color x:Key="Color.TextDisabled">#FF555555</Color>
    <Color x:Key="Color.Cool">#FF4A8FE0</Color>
    <Color x:Key="Color.Warm">#FFE0574A</Color>
    <Color x:Key="Color.Warning">#FFF0C43C</Color>

    <!-- Brushes. -->
    <LinearGradientBrush x:Key="Brush.Window" StartPoint="0,0" EndPoint="0.6,1">
        <GradientStop Color="{StaticResource Color.WindowTop}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Window}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.Card" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.CardTop}" Offset="0" />
        <GradientStop Color="{StaticResource Color.Card}" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.Tile" Color="{StaticResource Color.Tile}" />
    <SolidColorBrush x:Key="Brush.TileHover" Color="{StaticResource Color.TileHover}" />
    <SolidColorBrush x:Key="Brush.TilePressed" Color="{StaticResource Color.TilePressed}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentDim" Color="{StaticResource Color.AccentDim}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSoft" Color="{StaticResource Color.TextSoft}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.Cool" Color="{StaticResource Color.Cool}" />
    <SolidColorBrush x:Key="Brush.Warm" Color="{StaticResource Color.Warm}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.InfoBox" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Brush.WarningBox" Color="#FF221F17" />
    <SolidColorBrush x:Key="Brush.SuccessBox" Color="#FF18201A" />

    <!-- Type: Titillium Web, built into the exe. -->
    <FontFamily x:Key="Font.Main">pack://application:,,,/Assets/Fonts/#Titillium Web</FontFamily>
    <FontFamily x:Key="Font.Symbols">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Sizes. -->
    <CornerRadius x:Key="Radius.Card">6</CornerRadius>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <Thickness x:Key="Padding.Card">16</Thickness>
</ResourceDictionary>
