<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:BladeControl.UI">

    <ui:FormatConverter x:Key="Format" />
    <BooleanToVisibilityConverter x:Key="Visible" />
    <ui:InverseVisibilityConverter x:Key="Hidden" />

    <!-- ===== Text ===== -->

    <Style x:Key="Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- A short warning in red under a setting, gone while there is nothing to say. -->
    <Style x:Key="Text.Status" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Warm}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Text.Scale" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
    </Style>

    <!-- ===== Icons ===== -->

    <!-- A filled icon from Icons.xaml, scaled to its box: <Path Style="{StaticResource IconPath}" Data="{StaticResource Icon.Cpu}" /> -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <!-- A line icon on the 24 grid, drawn with the control's foreground. -->
    <Style x:Key="LineIcon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
    </Style>

    <!-- ===== Card ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="Separator" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Brush.Line}" />
        <Setter Property="Margin" Value="0,24" />
    </Style>

    <!-- An explanation in a framed box, with an icon at its left. Tag is the icon's geometry. -->
    <Style x:Key="NoteBox" TargetType="ContentControl">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}" />
        <Setter Property="Background" Value="{StaticResource Brush.InfoBox}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
        <Setter Property="Tag" Value="{StaticResource Icon.Info}" />
        <Setter Property="ui:Note.IconBrush" Value="{StaticResource Brush.TextSoft}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="18,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,14,0" Stretch="Uniform"
                                  Data="{TemplateBinding Tag}" Stroke="{TemplateBinding ui:Note.IconBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="LineHeight" Value="20" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WarningBox" TargetType="ContentControl" BasedOn="{StaticResource NoteBox}">
        <Setter Property="Background" Value="{StaticResource Brush.WarningBox}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Tag" Value="{StaticResource Icon.Warning}" />
        <Setter Property="ui:Note.IconBrush" Value="{StaticResource Brush.Warning}" />
    </Style>

    <Style x:Key="SuccessBox" TargetType="ContentControl" BasedOn="{StaticResource NoteBox}">
        <Setter Property="Background" Value="{StaticResource Brush.SuccessBox}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Tag" Value="{StaticResource Icon.Check}" />
        <Setter Property="ui:Note.IconBrush" Value="{StaticResource Brush.Accent}" />
    </Style>

    <!-- ===== Window caption buttons ===== -->

    <!--
        Windows 11's own caption buttons, as Open Shark shows them: 46 by 36,
        square, flush with the window's top right corner, with grey symbols that
        turn white on a faint highlight. Close turns red.
    -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="#FF8B8B92" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Symbols}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Tag" Value="#1AFFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Tag" Value="#FFC42B1C" />
    </Style>

    <!-- ===== Navigation ===== -->

    <!-- A square page button with a symbol, beside refresh: Settings. Green on a dark tile, solid green when open. -->
    <Style x:Key="IconTab" TargetType="RadioButton">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="GroupName" Value="SubTab" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TileHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The pages of a section: green words, the open one on a green block. -->
    <Style x:Key="SubTab" TargetType="RadioButton">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,2,10,3" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="GroupName" Value="SubTab" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Tile}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A square button with a line icon: back, forward, refresh. Content is the icon's geometry. -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}">
                        <Path Width="14" Height="14" Data="{TemplateBinding Content}" Style="{StaticResource LineIcon}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TileHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TilePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextDisabled}" />
                            <Setter TargetName="Back" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Choices ===== -->

    <!-- One of a row of choices: a dark tile with green words, the chosen one solid green. -->
    <Style x:Key="Tile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="Scale" />
                        </Border.RenderTransform>
                        <!-- In a narrow window the content shrinks to fit instead of being cut off. -->
                        <Viewbox StretchDirection="DownOnly" Margin="8,6"
                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TileHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1" Duration="0:0:0.25">
                                            <DoubleAnimation.EasingFunction>
                                                <BackEase Amplitude="0.6" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A performance mode: a tall tile with its icon in a disc above the name. Tag is the icon's geometry. -->
    <Style x:Key="ModeTile" TargetType="RadioButton" BasedOn="{StaticResource Tile}">
        <Setter Property="Height" Value="172" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel>
                        <Border Width="60" Height="60" CornerRadius="30" HorizontalAlignment="Center" Margin="0,0,0,14"
                                Background="#26000000">
                            <Path Width="26" Height="26" Style="{StaticResource IconPath}"
                                  Data="{Binding Tag, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Border>
                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Two or three small choices in a dark strip, as in "Plugged In | On Battery". -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TilePressed}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentStrip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Switch ===== -->

    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Drawn and moved by SwitchVisual: the knob stretches while pressed and glides across on a spring. -->
                    <ui:SwitchVisual IsOn="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}"
                                     IsPressed="{TemplateBinding IsPressed}" IsHovered="{TemplateBinding IsMouseOver}"
                                     HasKeyboardFocus="{TemplateBinding IsKeyboardFocused}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Lighting ===== -->

    <!-- The effects' rainbow, corner to corner, as the reference's icons are painted. -->
    <LinearGradientBrush x:Key="Brush.EffectRainbow" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFF2D95" Offset="0" />
        <GradientStop Color="#FFFF7A1A" Offset="0.25" />
        <GradientStop Color="#FFFFE53B" Offset="0.45" />
        <GradientStop Color="#FF3BE26B" Offset="0.62" />
        <GradientStop Color="#FF20C8FF" Offset="0.8" />
        <GradientStop Color="#FF8B5CFF" Offset="1" />
    </LinearGradientBrush>

    <!-- The prism's shaded face. -->
    <LinearGradientBrush x:Key="Brush.EffectRainbowDark" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FF20C8FF" Offset="0" />
        <GradientStop Color="#FF6E5BFF" Offset="0.5" />
        <GradientStop Color="#FFD14BFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.EffectOff" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Color="#FFFF3B6B" Offset="0" />
        <GradientStop Color="#FFFF7A3B" Offset="1" />
    </LinearGradientBrush>

    <!-- An effect's icon, drawn from its kind (EffectIcon), on a 24 grid. -->
    <DataTemplate x:Key="EffectIconTemplate">
        <Viewbox Width="26" Height="26">
            <Canvas Width="24" Height="24">
                <!-- Static: a prism, its lit face and its shaded face. -->
                <Canvas x:Name="Static" Visibility="Collapsed">
                    <Path Data="M12,2 L3,18.5 L12,22 Z" Fill="{StaticResource Brush.EffectRainbow}" />
                    <Path Data="M12,2 L21,18.5 L12,22 Z" Fill="{StaticResource Brush.EffectRainbowDark}" />
                </Canvas>
                <!-- Breathing: a ring round a dot. -->
                <Canvas x:Name="Breathing" Visibility="Collapsed">
                    <Ellipse Canvas.Left="2.5" Canvas.Top="2.5" Width="19" Height="19" Stroke="{StaticResource Brush.EffectRainbow}" StrokeThickness="2.2" />
                    <Ellipse Canvas.Left="8" Canvas.Top="8" Width="8" Height="8" Fill="{StaticResource Brush.EffectRainbow}" />
                </Canvas>
                <!-- Spectrum: three stacked rings, the colors cycling. -->
                <Canvas x:Name="Spectrum" Visibility="Collapsed">
                    <Ellipse Canvas.Left="2.5" Canvas.Top="3.5" Width="19" Height="6" Stroke="{StaticResource Brush.EffectRainbow}" StrokeThickness="2" />
                    <Ellipse Canvas.Left="2.5" Canvas.Top="9" Width="19" Height="6" Stroke="{StaticResource Brush.EffectRainbow}" StrokeThickness="2" />
                    <Ellipse Canvas.Left="2.5" Canvas.Top="14.5" Width="19" Height="6" Stroke="{StaticResource Brush.EffectRainbow}" StrokeThickness="2" />
                </Canvas>
                <!-- Wave: a breaking wave. -->
                <Path x:Name="Wave" Visibility="Collapsed" Fill="{StaticResource Brush.EffectRainbow}"
                      Data="M2,20 C2,11.5 7,5 13.5,5 C18.5,5 21.5,8.2 21.5,11.6 C21.5,14.2 19.6,15.8 17.6,15.8 C15.6,15.8 14.5,14.3 15.2,12.6 C12.6,12.9 11,15 11,17.2 C11,18.6 11.6,19.6 12.4,20 L22,20 L22,22 L2,22 Z" />
                <!-- Off: a circle struck through. -->
                <Canvas x:Name="Off" Visibility="Collapsed">
                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="{StaticResource Brush.EffectOff}" StrokeThickness="2.2" />
                    <Path Data="M6.4,6.4 L17.6,17.6" Stroke="{StaticResource Brush.EffectOff}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Canvas>
            </Canvas>
        </Viewbox>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="Static">
                <Setter TargetName="Static" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Breathing">
                <Setter TargetName="Breathing" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Spectrum">
                <Setter TargetName="Spectrum" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Wave">
                <Setter TargetName="Wave" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="Off">
                <Setter TargetName="Off" Property="Visibility" Value="Visible" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A lighting effect as a black square with its icon; the chosen one framed in white, as in the reference. -->
    <Style x:Key="EffectTile" TargetType="RadioButton">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Background" Value="#FF070707" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ContentTemplate" Value="{StaticResource EffectIconTemplate}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Back" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="2"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="#FF3A3A3A" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A color to pick: a disc, ringed in white when chosen. Background is the color. -->
    <Style x:Key="Swatch" TargetType="RadioButton">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                        <Ellipse Margin="4" Fill="{TemplateBinding Background}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Drop-down ===== -->

    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Back" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A dark box with the choice and a chevron; its list opens below. -->
    <Style x:Key="Dropdown" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}" />
        <Setter Property="ui:DropdownMotion.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Back" Background="{StaticResource Brush.Tile}" CornerRadius="{StaticResource Radius.Control}" />
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TileHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="Choice" Margin="12,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" />
                        <Path x:Name="Chevron" Width="9" Height="5" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"
                              Data="M0,0 L4.5,4.5 L9,0" Stroke="{StaticResource Brush.TextSoft}" StrokeThickness="1.5" Stretch="Uniform" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               PopupAnimation="None" VerticalOffset="4">
                            <!-- DropdownMotion scales it in, fades the items in and glides the highlight. -->
                            <Border x:Name="Menu" Background="{StaticResource Brush.TilePressed}" CornerRadius="{StaticResource Radius.Control}" Padding="4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <Grid x:Name="HighlightHost">
                                        <Border x:Name="Highlight" Background="{StaticResource Brush.TileHover}" CornerRadius="3" Opacity="0"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" />
                                        <ItemsPresenter />
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Action rows ===== -->

    <!-- A small dark button with green words, at the right of a row: Clean, Free up, Open... -->
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
        <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TileHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TilePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A green arc going round, for as long as a job runs. -->
    <Style x:Key="Spinner" TargetType="Path">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Data" Value="M11,2 A9,9 0 1 1 2,11" />
        <Setter Property="Stroke" Value="{StaticResource Brush.Accent}" />
        <Setter Property="StrokeThickness" Value="2.4" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsVisible" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="Spin">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="Spin" />
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- An ActionRow: its title and the line under it, and its button, which gives way to the spinner while it works. -->
    <DataTemplate x:Key="ActionRowTemplate">
        <Grid Margin="0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{Binding Hint}" />
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="92">
                <Button Style="{StaticResource ActionButton}" Content="{Binding ButtonText}" Command="{Binding RunCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource Hidden}}" />
                <Path Style="{StaticResource Spinner}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ===== Scroll bars: thin and dark ===== -->

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Bar" CornerRadius="3" Background="#FF3A3A3A" Margin="1,0" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bar" Property="Background" Value="#FF555555" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tool tips ===== -->

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource Brush.TilePressed}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Main}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
