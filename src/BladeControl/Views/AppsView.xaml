<UserControl x:Class="BladeControl.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BladeControl.UI">

    <UserControl.Resources>
        <!-- An app's own icon, or the first letter of its name on a tile when it has none. -->
        <DataTemplate x:Key="AppIconTemplate">
            <Grid>
                <Border x:Name="Letter" Background="{StaticResource Brush.Tile}" CornerRadius="6" Visibility="Collapsed">
                    <Viewbox Margin="5">
                        <TextBlock Text="{Binding Name, Converter={x:Static ui:FirstLetterConverter.Instance}}" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </Viewbox>
                </Border>
                <Image x:Name="Picture" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Letter" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An app in the list: grey while picked, and under the pointer. -->
        <Style x:Key="AppItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AppItem_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Tile}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Tile}" />
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Brush.AccentDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The search box over the list. -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Brush.Text}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Brush.Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Back" Background="{StaticResource Brush.Tile}" CornerRadius="{StaticResource Radius.Control}"
                                BorderBrush="Transparent" BorderThickness="1" Height="36">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Symbols}" FontSize="13"
                                           Foreground="{StaticResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{ui:T 'Search apps'}" Foreground="{StaticResource Brush.TextMuted}"
                                           VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
                                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Brush.AccentDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A setting of the picked app: its name at the left, its choice at the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <!-- As wide as its words only, so its tooltip shows over the text and not the empty space beside it. -->
        <Style x:Key="SettingName" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingChoice" TargetType="ComboBox" BasedOn="{StaticResource Dropdown}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Two columns, or one under the other in a narrow window. -->
    <ui:AdaptiveColumns>

        <!-- ===== Every app on the PC ===== -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,8" MinHeight="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'App profiles'}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ProfilesOn}"
                              ToolTip="{ui:T 'Turn every app profile on or off'}" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,16" TextWrapping="Wrap"
                           Text="{ui:T 'Pick an app to choose its settings. While it is running they are used; when it closes, everything goes back as it was.'}" />

                <!-- The search, and beside it any other program to add. -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Style="{StaticResource ActionButton}" Height="36" Margin="8,0,0,0"
                            Content="{ui:T 'Find a program...'}" Command="{Binding BrowseCommand}" />
                </Grid>

                <Path Style="{StaticResource Spinner}" HorizontalAlignment="Center" Margin="0,12"
                      Visibility="{Binding Scanning, Converter={StaticResource Visible}}" />

                <!-- Its own scroll, so the settings at the right stay in view. -->
                <ListBox x:Name="AppList" ItemsSource="{Binding AppsView}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource AppItem}"
                         Background="Transparent" Foreground="{StaticResource Brush.Text}" BorderThickness="0" Padding="0"
                         MaxHeight="560" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppIconTemplate}" Width="29.5" Height="29.5" />
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <!-- Its app is running and its profile is on. -->
                                        <Border Background="{StaticResource Brush.AccentDim}" CornerRadius="8" Padding="7,1,7,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{ui:T 'Active'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Hint}" Margin="0,2,0,0"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Something is set for it: a small green bubble with a check. -->
                                <Grid Grid.Column="2" Width="20" Height="20" VerticalAlignment="Center" ToolTip="{ui:T 'Has its own settings'}"
                                      Visibility="{Binding IsConfigured, Converter={StaticResource Visible}}">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <!-- Switched off: kept, but greyed. -->
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.35" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Ellipse Fill="{StaticResource Brush.Accent}" />
                                    <Path Data="M5.5,10.5 L8.6,13.5 L14.5,7" Stroke="{StaticResource Brush.OnAccent}" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Text="{Binding ListStatus}" Style="{StaticResource Text.Hint}" />
            </StackPanel>
        </Border>

        <!-- ===== The picked app's settings, or "No app" ===== -->
        <Border x:Name="EditorCard" Style="{StaticResource Card}" VerticalAlignment="Top">
            <Grid>
                <!-- Nothing picked. -->
                <StackPanel Visibility="{Binding ShowsEditor, Converter={StaticResource Hidden}}" Margin="0,40" HorizontalAlignment="Center">
                    <!-- Boxicons' category-alt (bx-category-alt), drawn on a 24 grid. -->
                    <Path Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Fill="{StaticResource Brush.Accent}"
                          Data="M4 11h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1zm1-6h4v4H5V5zm15-2h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1zm-1 6h-4V5h4v4zm-9 12a1 1 0 0 0 1-1v-6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h6zm-5-6h4v4H5v-4zm13-2c-2.206 0-4 1.794-4 4s1.794 4 4 4 4-1.794 4-4-1.794-4-4-4zm0 6c-1.103 0-2-.897-2-2s.897-2 2-2 2 .897 2 2-.897 2-2 2z" />
                    <TextBlock Text="{ui:T 'No app'}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Text.Hint}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="280"
                               Text="{ui:T 'Pick an app in the list to choose what changes while it runs.'}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsEditor, Converter={StaticResource Visible}}">
                    <Grid Margin="0,0,0,18" MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl Grid.RowSpan="2" Content="{Binding Selected}" ContentTemplate="{StaticResource AppIconTemplate}" Width="33" Height="33"
                                        VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.CardTitle}" Text="{Binding Selected.Name}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <!-- On the name's line, at the right: this app's profile on or off. -->
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Selected.Enabled}" Margin="12,0,0,0"
                                  VerticalAlignment="Center" ToolTip="{ui:T 'Use this profile'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Text.Hint}" Text="{Binding Selected.SourceName}"
                                   Margin="0,2,0,0" ToolTip="{Binding Selected.Path}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Power mode'}" ToolTip="{ui:T 'The performance mode while the app runs.'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding ModeOptions}" SelectedIndex="{Binding ModeIndex}" />
                    </Grid>

                    <!-- Custom's levels, only in Custom. -->
                    <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource Visible}}">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'CPU preset'}" ToolTip="{ui:T 'How much power the processor may use.'}" Margin="16,0,16,0" />
                            <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding CpuOptions}" SelectedIndex="{Binding CpuIndex}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'GPU preset'}" ToolTip="{ui:T 'How much power the graphics card may use.'}" Margin="16,0,16,0" />
                            <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding GpuOptions}" SelectedIndex="{Binding GpuIndex}" />
                        </Grid>
                    </StackPanel>

                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding HasMaxFan, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Fans'}" ToolTip="{ui:T 'Automatic, or both fans at full speed.'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding FanOptions}" SelectedIndex="{Binding FanIndex}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Refresh rate'}" ToolTip="{ui:T 'How many times per second the screen updates.'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding RateOptions}" SelectedIndex="{Binding RateIndex}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Color profile'}" ToolTip="{ui:T 'The screen colors, such as Night light.'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding ColorOptions}" SelectedIndex="{Binding ColorIndex}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Keyboard lighting'}" ToolTip="{ui:T 'The keyboard lighting effect.'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding KeyboardOptions}" SelectedIndex="{Binding KeyboardIndex}" />
                    </Grid>

                    <!-- The color, only with an effect that shows one. -->
                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding OffersKeyboardColor, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Keyboard color'}" ToolTip="{ui:T 'The color the keyboard lights up in.'}" Margin="16,0,16,0" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding KeyboardColorOptions}" SelectedIndex="{Binding KeyboardColorIndex}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Swatch}" Value="{x:Null}">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding OffersBrightness, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Keyboard brightness'}" ToolTip="{ui:T 'How bright the keyboard light is.'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding BrightnessOptions}" SelectedIndex="{Binding BrightnessIndex}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Game mode'}" ToolTip="{ui:T 'Blocks the Windows key (and Alt+Tab, Alt+F4) so you do not leave the game by accident.'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding GameModeOptions}" SelectedIndex="{Binding GameModeIndex}" />
                    </Grid>

                    <ContentControl Style="{StaticResource NoteBox}" Margin="0,18,0,0"
                                    Content="{ui:T 'No change leaves that setting as it is. Custom and maximum fans need the charger: on battery, the battery mode stays.'}" />

                    <Button Style="{StaticResource ActionButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Content="{ui:T 'Reset'}" Command="{Binding ResetCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </ui:AdaptiveColumns>
</UserControl>
