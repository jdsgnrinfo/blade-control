<UserControl x:Class="BladeControl.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BladeControl.UI">

    <UserControl.Resources>
        <!-- An app's own icon, or the first letter of its name on a tile when it has none. -->
        <DataTemplate x:Key="AppIconTemplate">
            <Grid>
                <Border x:Name="Letter" Background="{StaticResource Brush.Tile}" CornerRadius="6" Visibility="Collapsed">
                    <Viewbox Margin="5">
                        <TextBlock Text="{Binding Name, Converter={x:Static ui:FirstLetterConverter.Instance}}" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Accent}" />
                    </Viewbox>
                </Border>
                <Image x:Name="Picture" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="Letter" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- An app in the list: lit while picked, a shade lighter under the pointer. -->
        <Style x:Key="AppItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="AppItem_Click" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}" Padding="12,10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Tile}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Tile}" />
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Brush.AccentDim}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A game or app to add: the whole line is the button. -->
        <Style x:Key="CandidateButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="{StaticResource Radius.Control}" Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.Tile}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource Brush.TilePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A setting of the picked app: its name at the left, its choice at the right. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Margin" Value="0,3" />
        </Style>

        <Style x:Key="SettingName" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SettingChoice" TargetType="ComboBox" BasedOn="{StaticResource Dropdown}">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="MinWidth" Value="160" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Two columns, or one under the other in a narrow window. -->
    <ui:AdaptiveColumns>

        <!-- ===== The apps with a profile ===== -->
        <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <Grid Margin="0,0,0,8" MinHeight="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'App profiles'}" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ProfilesOn}"
                              ToolTip="{ui:T 'Turn every app profile on or off'}" />
                </Grid>
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,18" TextWrapping="Wrap"
                           Text="{ui:T 'While one of these apps is running, its settings are used. When it closes, everything goes back as it was.'}" />

                <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource AppItem}"
                         Background="Transparent" Foreground="{StaticResource Brush.Text}" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="False"
                         Visibility="{Binding HasApps, Converter={StaticResource Visible}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppIconTemplate}" Width="31" Height="31" />
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <!-- Switched off: kept, but greyed. -->
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <!-- Its app is running and its profile is on. -->
                                        <Border Background="{StaticResource Brush.AccentDim}" CornerRadius="8" Padding="7,1,7,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                                            <TextBlock Text="{ui:T 'Active'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Hint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ContentControl Style="{StaticResource NoteBox}" Visibility="{Binding HasApps, Converter={StaticResource Hidden}}"
                                Content="{ui:T 'No apps yet. Add a game or an app to give it its own mode, fans, refresh rate, colors and keyboard lighting.'}" />
            </StackPanel>
        </Border>

        <StackPanel>
            <!-- ===== The picked app's settings ===== -->
            <Border x:Name="EditorCard" Style="{StaticResource Card}" VerticalAlignment="Top" Visibility="{Binding ShowsEditor, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Grid Margin="0,0,0,18" MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl Grid.RowSpan="2" Content="{Binding Selected}" ContentTemplate="{StaticResource AppIconTemplate}" Width="35" Height="35"
                                        VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.CardTitle}" Text="{Binding Selected.Name}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <!-- On the name's line, at the right: this app's profile on or off. -->
                        <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Selected.Enabled}" Margin="12,0,0,0"
                                  VerticalAlignment="Center" ToolTip="{ui:T 'Use this profile'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Text.Hint}" Text="{Binding Selected.SourceName}"
                                   Margin="0,2,0,0" ToolTip="{Binding Selected.Path}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Power mode'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding ModeOptions}" SelectedIndex="{Binding ModeIndex}" />
                    </Grid>

                    <!-- Custom's levels, only in Custom. -->
                    <StackPanel Visibility="{Binding IsCustomMode, Converter={StaticResource Visible}}">
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'CPU preset'}" Margin="16,0,16,0" />
                            <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding CpuOptions}" SelectedIndex="{Binding CpuIndex}" />
                        </Grid>
                        <Grid Style="{StaticResource SettingRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'GPU preset'}" Margin="16,0,16,0" />
                            <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding GpuOptions}" SelectedIndex="{Binding GpuIndex}" />
                        </Grid>
                    </StackPanel>

                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding HasMaxFan, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Fans'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding FanOptions}" SelectedIndex="{Binding FanIndex}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Refresh rate'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding RateOptions}" SelectedIndex="{Binding RateIndex}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Color profile'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding ColorOptions}" SelectedIndex="{Binding ColorIndex}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Keyboard lighting'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding KeyboardOptions}" SelectedIndex="{Binding KeyboardIndex}" />
                    </Grid>

                    <Grid Style="{StaticResource SettingRow}" Visibility="{Binding OffersBrightness, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SettingName}" Text="{ui:T 'Keyboard brightness'}" />
                        <ComboBox Style="{StaticResource SettingChoice}" ItemsSource="{Binding BrightnessOptions}" SelectedIndex="{Binding BrightnessIndex}" />
                    </Grid>

                    <ContentControl Style="{StaticResource NoteBox}" Margin="0,18,0,0"
                                    Content="{ui:T 'No change leaves that setting as it is. Custom and maximum fans need the charger: on battery, the battery mode stays.'}" />

                    <Button Style="{StaticResource ActionButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Content="{ui:T 'Remove app'}" Command="{Binding RemoveCommand}" />
                </StackPanel>
            </Border>

            <!-- ===== Adding an app: the games found, or the apps open now, or any program ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,18" MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Add app'}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource SegmentStrip}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="AddFrom" Content="{ui:T 'Games'}" IsChecked="{Binding AddingGames}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="AddFrom" Content="{ui:T 'Open apps'}" IsChecked="{Binding AddingOpenApps}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Path Style="{StaticResource Spinner}" HorizontalAlignment="Center" Margin="0,8"
                          Visibility="{Binding Scanning, Converter={StaticResource Visible}}" />

                    <ItemsControl ItemsSource="{Binding Candidates}" Margin="-10,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CandidateButton}" ToolTip="{Binding Path}"
                                        Command="{Binding DataContext.AddCandidateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource AppIconTemplate}" Width="26" Height="26" />
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Hint}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{ui:T 'Add'}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding CandidatesStatus}" Style="{StaticResource Text.Hint}" TextWrapping="Wrap" />

                    <ContentControl Style="{StaticResource NoteBox}" Margin="0,16,0,0" Visibility="{Binding AddingGames, Converter={StaticResource Visible}}"
                                    Content="{ui:T 'Games installed with Steam, Epic Games, Xbox and Battle.net. Anything that runs from the game\'s folder counts, its own launcher too.'}" />

                    <Button Style="{StaticResource ActionButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                            Content="{ui:T 'Find a program...'}" Command="{Binding BrowseCommand}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ui:AdaptiveColumns>
</UserControl>
