<UserControl x:Class="BladeControl.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BladeControl.UI">

    <UserControl.Resources>
        <!-- The external display's drawing: grey while none is connected, lit green while one is. -->
        <Style x:Key="MonitorScreen" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Track}" />
            <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExternalDisplay}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF223D1C" Offset="0" />
                                <GradientStop Color="#FF162A13" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorStand" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Track}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExternalDisplay}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorStatus" TargetType="TextBlock">
            <Setter Property="Text" Value="{ui:T 'No external display'}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExternalDisplay}" Value="True">
                    <Setter Property="Text" Value="{ui:T 'External display detected'}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A link inside a note: green, underlined under the pointer. -->
        <Style x:Key="NoteLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Brush.AccentHover}" />
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Two columns, or one under the other in a narrow window. -->
    <ui:AdaptiveColumns>

        <!-- Refresh rate, and the color profile under it. -->
        <StackPanel>
            <!-- ===== Refresh rate ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,18" MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Refresh rate'}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Resolution}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RefreshChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- The rate's icon, as in Razer Helper; its name under the pointer. -->
                                <RadioButton Style="{StaticResource Tile}" GroupName="RefreshRate" Height="64" Margin="0,0,8,0"
                                             IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}">
                                    <Path Data="{Binding Icon}" Height="24" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding RateStatus}" Style="{StaticResource Text.Status}" Margin="0,10,0,0" />

                    <ContentControl Style="{StaticResource NoteBox}" Margin="0,18,0,0" Content="{Binding AutoHint}" />
                </StackPanel>
            </Border>

            <!-- ===== Color profile ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,18" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Color profile'}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- As the keyboard's effects: the profiles as tiles, the chosen one's name and what it does under them. -->
                    <TextBlock Style="{StaticResource Text.Label}" Text="{ui:T 'Screen colors'}" HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding ProfileChoices}" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource EffectTile}" ContentTemplate="{StaticResource ProfileIconTemplate}"
                                             GroupName="ColorProfile" Content="{Binding Profile}"
                                             IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ProfileName}" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProfileDescription}" Style="{StaticResource Text.Hint}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource Text.Status}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The panel's details, and the external display under them. -->
        <StackPanel>
            <!-- ===== The panel, as Windows reports it ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Panel'}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PanelDetails}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Hint}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ===== External display: whether one is connected, and where its rate is set ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'External display'}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- A monitor on its stand. -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Border Style="{StaticResource MonitorScreen}" Width="132" Height="84" CornerRadius="4" BorderThickness="2" />
                        <Border Style="{StaticResource MonitorStand}" Width="44" Height="12" CornerRadius="0,0,3,3" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource MonitorStatus}" HorizontalAlignment="Center" Margin="0,14,0,0"
                               FontSize="16" FontWeight="SemiBold" />

                    <ContentControl Style="{StaticResource NoteBox}" Margin="0,22,0,0">
                        <TextBlock TextWrapping="Wrap" LineHeight="20"><Run Text="{ui:T 'To choose the refresh rate on a secondary monitor connected by HDMI, use the Windows '}" /><Hyperlink Style="{StaticResource NoteLink}" Command="{Binding OpenDisplaySettingsCommand}"><Run Text="{ui:T 'Display Settings'}" /></Hyperlink><Run Text="." /></TextBlock>
                    </ContentControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ui:AdaptiveColumns>
</UserControl>
