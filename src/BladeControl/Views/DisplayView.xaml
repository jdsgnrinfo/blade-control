<UserControl x:Class="BladeControl.Views.DisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BladeControl.UI">

    <UserControl.Resources>
        <!-- The external display's drawing: grey while none is connected, lit green while one is. -->
        <Style x:Key="MonitorScreen" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Track}" />
            <Setter Property="Background" Value="{StaticResource Brush.Tile}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExternalDisplay}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF223D1C" Offset="0" />
                                <GradientStop Color="#FF162A13" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorStand" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Brush.Track}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExternalDisplay}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MonitorStatus" TargetType="TextBlock">
            <Setter Property="Text" Value="{ui:T 'No external display'}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasExternalDisplay}" Value="True">
                    <Setter Property="Text" Value="{ui:T 'External display detected'}" />
                    <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Two columns, or one under the other in a narrow window. -->
    <ui:AdaptiveColumns>

        <!-- Refresh rate, and the color profile under it. -->
        <StackPanel>
            <!-- ===== Refresh rate ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,18" MinHeight="34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Refresh rate'}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Resolution}" Style="{StaticResource Text.Hint}" VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RefreshChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- The rate's icon, as in Razer Helper; its name under the pointer. -->
                                <RadioButton Style="{StaticResource Tile}" GroupName="RefreshRate" Height="64" Margin="0,0,8,0"
                                             IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}">
                                    <Path Data="{Binding Icon}" Height="24" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding RateStatus}" Style="{StaticResource Text.Status}" Margin="0,10,0,0" />

                    <ContentControl Style="{StaticResource NoteBox}" Margin="0,18,0,0" Content="{Binding AutoHint}" />
                </StackPanel>
            </Border>

            <!-- ===== Color profile ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,18" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Color profile'}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- As the keyboard's effects: the profiles as tiles, the chosen one's name and what it does under them. -->
                    <TextBlock Style="{StaticResource Text.Label}" Text="{ui:T 'Screen colors'}" HorizontalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding ProfileChoices}" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource EffectTile}" ContentTemplate="{StaticResource ProfileIconTemplate}"
                                             GroupName="ColorProfile" Content="{Binding Profile}"
                                             IsChecked="{Binding IsSelected}" ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding ProfileName}" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProfileDescription}" Style="{StaticResource Text.Hint}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ProfileStatus}" Style="{StaticResource Text.Status}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- The graphics, and the external display under them. -->
        <StackPanel>
            <!-- ===== Graphics: the dedicated GPU turned off, so everything runs on the integrated one ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Graphics'}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Integrated graphics only'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{Binding IntegratedOnlyHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                  IsChecked="{Binding IntegratedOnly}">
                            <CheckBox.IsEnabled>
                                <MultiBinding Converter="{x:Static ui:AllTrueConverter.Instance}">
                                    <Binding Path="HasDedicatedGpu" />
                                    <Binding Path="IntegratedOnlyChanging" Converter="{x:Static ui:NotConverter.Instance}" />
                                </MultiBinding>
                            </CheckBox.IsEnabled>
                        </CheckBox>
                    </Grid>

                    <!-- What the dedicated GPU is doing now, read every few seconds while the page is open. -->
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding ShowGpuActivity, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GpuAwake}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="13" Text="{Binding GpuState}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Text.Hint}" Margin="16,4,0,0" TextWrapping="Wrap" Text="{Binding GpuUsers}" />
                        <TextBlock Margin="16,6,0,0" FontSize="13" Visibility="{Binding CanCloseGpuApps, Converter={StaticResource Visible}}">
                            <Hyperlink Style="{StaticResource NoteLink}" Command="{Binding CloseGpuAppsCommand}"><Run Text="{ui:T 'Close these apps'}" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- What the switch does and its warnings, hidden until asked for. -->
                    <StackPanel Visibility="{Binding ShowGraphicsInfo, Converter={StaticResource Visible}}">
                        <ContentControl Style="{StaticResource NoteBox}" Margin="0,16,0,0">
                            <TextBlock TextWrapping="Wrap" LineHeight="20">
                                <Run Text="{ui:T 'On, the dedicated GPU is turned off and everything runs on the integrated one: more battery and less heat. Off, Windows picks the GPU by itself, as usual.'}" />
                                <LineBreak /><LineBreak /><Run Text="{ui:T 'While it is on:'}" FontWeight="SemiBold" />
                                <LineBreak /><Run Text="{ui:T '- The HDMI and USB-C video ports show no picture: they run on the dedicated GPU.'}" />
                                <LineBreak /><Run Text="{ui:T '- Games and 3D apps run much slower.'}" />
                                <LineBreak /><Run Text="{ui:T '- It stays on after restarting, until you turn it off. A driver update may turn the GPU back on.'}" />
                            </TextBlock>
                        </ContentControl>
                    </StackPanel>

                    <TextBlock Margin="0,14,0,0" FontSize="13">
                        <Hyperlink Style="{StaticResource NoteLink}" Command="{Binding ToggleGraphicsInfoCommand}"><Run Text="{Binding GraphicsInfoLink, Mode=OneWay}" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ===== External display: whether one is connected, and where its rate is set ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'External display'}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- A monitor on its stand. -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Border Style="{StaticResource MonitorScreen}" Width="132" Height="84" CornerRadius="4" BorderThickness="2" />
                        <Border Style="{StaticResource MonitorStand}" Width="44" Height="12" CornerRadius="0,0,3,3" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource MonitorStatus}" HorizontalAlignment="Center" Margin="0,14,0,0"
                               FontSize="16" FontWeight="SemiBold" />

                    <Border Style="{StaticResource Separator}" Margin="0,24,0,20" />

                    <!-- Closing the lid leaves the laptop running while a monitor is connected. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Style="{StaticResource Text.Body}" Text="{ui:T 'Keep running with the lid closed'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="{ui:T 'With a monitor connected and the charger plugged in, closing the lid does not put the laptop to sleep. On battery it still does.'}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding KeepRunningWithLidClosed}" />
                    </Grid>

                    <!-- With the dedicated GPU off, a monitor on its ports shows nothing. -->
                    <ContentControl Style="{StaticResource WarningBox}" Margin="0,22,0,0"
                                    Visibility="{Binding ExternalDisplayDark, Converter={StaticResource Visible}}"
                                    Content="{ui:T 'The dedicated GPU is off, so this display gets no picture. Turn Integrated graphics only off to use it.'}" />

                    <ContentControl Style="{StaticResource NoteBox}" Margin="0,22,0,0">
                        <TextBlock TextWrapping="Wrap" LineHeight="20"><Run Text="{ui:T 'To choose the refresh rate on a secondary monitor connected by HDMI, use the Windows '}" /><Hyperlink Style="{StaticResource NoteLink}" Command="{Binding OpenDisplaySettingsCommand}"><Run Text="{ui:T 'Display Settings'}" /></Hyperlink><Run Text="." /></TextBlock>
                    </ContentControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ui:AdaptiveColumns>
</UserControl>
