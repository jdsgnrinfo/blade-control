<Window x:Class="BladeControl.Views.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BladeControl.UI"
        Title="Blade Control" SizeToContent="WidthAndHeight" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowActivated="True"
        FontFamily="{StaticResource Font.Main}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- An item: white words, a fill across the whole width under the pointer. -->
        <Style x:Key="TrayItem" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14.7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" Padding="12,7,32,8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#FF333333" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#FF333333" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- A dark rounded panel with a thin border, as Razer Helper's tray menu. -->
    <Border x:Name="Panel" Margin="8" Background="#FF222222" BorderBrush="#FF2E2E2E" BorderThickness="1" CornerRadius="8" Padding="0,4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" />
        </Border.Effect>
        <StackPanel x:Name="Items" MinWidth="170">
            <Button Style="{StaticResource TrayItem}" Content="{ui:T 'Open Blade Control'}" Click="Open_Click" />
            <Border Height="1" Margin="8,3" Background="#FF2E2E2E" />
            <Button Style="{StaticResource TrayItem}" Content="{ui:T 'Exit'}" Click="Exit_Click" />
        </StackPanel>
    </Border>
</Window>
