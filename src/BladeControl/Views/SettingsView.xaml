<UserControl x:Class="BladeControl.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:BladeControl.UI">

    <!-- Two cards side by side, or one under the other in a narrow window. -->
    <ui:AdaptiveColumns>

        <!-- General, and the experimental options under it. -->
        <StackPanel>
            <!-- ===== General: language, start with Windows, stay on top ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'General'}" VerticalAlignment="Center" />
                    </Grid>
    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Language'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{ui:T 'Blade Control restarts to change the language.'}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource Dropdown}" MinWidth="120" VerticalAlignment="Center"
                                  ItemsSource="{Binding LanguageNames}" SelectedIndex="{Binding LanguageIndex}" />
                    </Grid>
    
                    <Border Style="{StaticResource Separator}" Margin="0,12" />
    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Start at login'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{ui:T 'Opens Blade Control when you sign in to Windows.'}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartAtLogin}" />
                    </Grid>
    
                    <Border Style="{StaticResource Separator}" Margin="0,12" />
    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Always on top'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{ui:T 'Keeps the window above other windows and games.'}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'System monitor'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{ui:T 'CPU, GPU and RAM use on the Performance page. Off, nothing is read for it, which saves a little battery.'}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Monitor.IsEnabled}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Performance mode shortcuts'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{Binding ProfileShortcutsHint}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ProfileShortcuts}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Check for updates automatically'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{ui:T 'Looks on GitHub for a newer version when Blade Control starts and once a day. Nothing is downloaded until you choose to update.'}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Updates.IsEnabled}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== Experimental: options that may not work on every Blade ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Experimental'}" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Turbo boost off in Silent'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0"
                                       Text="{ui:T 'Silent keeps the CPU at its base speed, which is what makes it quiet. Off, Silent leaves the turbo as the power plan has it: faster, but warmer and louder.'}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SilentTurnsBoostOff}" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Temperatures in the device panel'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{ui:T 'The CPU and GPU temperatures with their last hour\'s average, under the laptop\'s picture. Off, they are not read.'}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Device.ShowTemperatures}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Maintenance, and the coffee under it. -->
        <StackPanel>
            <!-- ===== Maintenance: Razer's drivers, the logs, the reset ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <Grid Margin="0,0,0,12" MinHeight="34">
                        <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Maintenance'}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Updates: the version in use, or the newer one with Update, its page and Skip. -->
                    <Grid Margin="0,6" DataContext="{Binding Updates}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding StatusText}" />
                            <TextBlock Margin="0,8,0,0" FontSize="13" HorizontalAlignment="Left"
                                       Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}">
                                <Hyperlink Style="{StaticResource NoteLink}" Command="{Binding OpenPageCommand}"><Run Text="{ui:T 'What is new'}" /></Hyperlink>
                                <Run Text="   " />
                                <Hyperlink Style="{StaticResource NoteLink}" Command="{Binding SkipCommand}"><Run Text="{ui:T 'Skip this version'}" /></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <Grid Grid.Column="1" VerticalAlignment="Center" MinWidth="92">
                            <Grid Visibility="{Binding IsBusy, Converter={StaticResource Hidden}}">
                                <Button Style="{StaticResource ActionButton}" Content="{ui:T 'Check now'}" Command="{Binding CheckNowCommand}"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource Hidden}}" />
                                <Button Style="{StaticResource ActionButton}" Content="{ui:T 'Update'}" Command="{Binding UpdateCommand}"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource Visible}}" />
                            </Grid>
                            <ui:MorphLoader Status="{Binding Status}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                        </Grid>
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Razer drivers and support'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{ui:T 'BIOS and driver updates for your laptop, on Razer\'s site.'}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="{ui:T 'Open'}" Command="{Binding OpenDriversCommand}"
                                VerticalAlignment="Center" />
                    </Grid>
    
                    <Border Style="{StaticResource Separator}" Margin="0,12" />
    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Logs'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{ui:T 'What Blade Control did and any errors, to share if something goes wrong.'}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="{ui:T 'Open'}" Command="{Binding OpenLogsCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <!-- A new issue on GitHub, with the laptop and versions filled in. -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Report a bug'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{ui:T 'Opens a report on GitHub (attaching the log and your exact model helps).'}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="{ui:T 'Report'}" Command="{Binding ReportBugCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />

                    <!-- The settings to a file and back: for a Windows reinstall, or another Blade. -->
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Your settings'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{ui:T 'Save your modes, app profiles and options to a file, or bring them back from one.'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionButton}" Content="{ui:T 'Export'}" Command="{Binding ExportSettingsCommand}" />
                            <Button Style="{StaticResource ActionButton}" Content="{ui:T 'Import'}" Command="{Binding ImportSettingsCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Separator}" Margin="0,12" />
    
                    <Grid Margin="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="14" Text="{ui:T 'Reset to defaults'}" />
                            <TextBlock Style="{StaticResource Text.Hint}" Margin="0,4,0,0" Text="{ui:T 'Clears your settings and puts the laptop back in Balanced. Asks first.'}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource ActionButton}" Content="{ui:T 'Reset'}" Command="{Binding ResetCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Scale}" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <!-- ===== Buy me a coffee: a link to the author's PayPal ===== -->
            <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Buy me a coffee'}" />
                    <TextBlock Style="{StaticResource Text.Hint}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="{ui:T 'Blade Control is free and made in my spare time. If it is useful to you, you can buy me a coffee: it helps me keep improving it.'}" />
                    <!-- A link like Display's "More information". -->
                    <TextBlock Margin="0,14,0,0" FontSize="13" HorizontalAlignment="Left">
                        <Hyperlink Style="{StaticResource NoteLink}" Command="{Binding OpenDonationCommand}" ToolTip="paypal.me/jotica96"><Run Text="{ui:T 'Buy me a coffee on PayPal'}" /></Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ui:AdaptiveColumns>
</UserControl>
