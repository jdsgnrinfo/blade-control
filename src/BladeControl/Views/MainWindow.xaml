<Window x:Class="BladeControl.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BladeControl.UI"
        xmlns:views="clr-namespace:BladeControl.Views"
        Title="Blade Control"
        Icon="pack://application:,,,/Assets/BladeControl.ico"
        Width="1000" Height="700" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Main}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        A normal Windows window (taskbar, snap, resize) with the concept's own title bar drawn in it.
        The one-pixel glass frame keeps Windows' own shadow, thin border and rounded corners.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Title bar: thin and quiet, as in Open Shark: a small mark, the name, and Windows' buttons ===== -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                <Image Width="16" Height="16" Source="pack://application:,,,/Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{ui:T 'Blade Control'}" Margin="8,0,0,1" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource Brush.TextMuted}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="{ui:T 'Minimize'}" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Maximize_Click" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="{ui:T 'Close'}" />
            </StackPanel>
        </Grid>

        <!-- ===== Page row: every page, the last change's message, and refresh ===== -->
        <Grid Grid.Row="1" Margin="24,8,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource SubTab}" Content="{ui:T 'Performance'}" IsChecked="{Binding IsPerformance}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{ui:T 'Apps'}" IsChecked="{Binding IsApps}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{ui:T 'Lighting'}" IsChecked="{Binding IsLighting}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{ui:T 'Display'}" IsChecked="{Binding IsDisplay}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{ui:T 'Battery'}" IsChecked="{Binding IsBattery}" />
                <RadioButton Style="{StaticResource SubTab}" Content="{ui:T 'Optimize'}" IsChecked="{Binding IsOptimize}" />
            </StackPanel>

            <!-- What the last change did, for a few seconds. -->
            <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0"
                       FontSize="13" TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Brush.Warm}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Content="{StaticResource Icon.Refresh}" Command="{Binding RefreshCommand}"
                        ToolTip="{ui:T 'Read the laptop again'}" />
                <RadioButton Style="{StaticResource IconTab}" Margin="6,0,0,0" IsChecked="{Binding IsSettings}" ToolTip="{ui:T 'Settings'}">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Font.Symbols}" FontSize="12" />
                </RadioButton>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" VerticalAlignment="Bottom" Height="1" Background="{StaticResource Brush.Line}" />

        <!--
            ===== Content: the page's cards, and the laptop's panel at the right =====
            One scroll bar, at the window's right edge. The panel is sticky: it
            follows the scroll so it stays in view (see MainWindow.KeepPanelInView).
        -->
        <ScrollViewer x:Name="PageScroll" ui:SmoothScroll.IsEnabled="True" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0" ScrollChanged="PageScroll_ScrollChanged">
            <Grid Margin="24,24,20,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <views:PerformanceView ui:Reveal.OnShow="True" DataContext="{Binding Performance}"
                                       Visibility="{Binding DataContext.IsPerformance, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <views:AppsView ui:Reveal.OnShow="True" DataContext="{Binding Apps}"
                                Visibility="{Binding DataContext.IsApps, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <views:LightingView ui:Reveal.OnShow="True" DataContext="{Binding Lighting}"
                                    Visibility="{Binding DataContext.IsLighting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <views:DisplayView ui:Reveal.OnShow="True" DataContext="{Binding Display}"
                                   Visibility="{Binding DataContext.IsDisplay, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <views:BatteryView ui:Reveal.OnShow="True" DataContext="{Binding Battery}"
                                   Visibility="{Binding DataContext.IsBattery, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <views:OptimizeView ui:Reveal.OnShow="True" DataContext="{Binding Optimize}"
                                    Visibility="{Binding DataContext.IsOptimize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <views:SettingsView ui:Reveal.OnShow="True" DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettings, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />

                <views:DevicePanel x:Name="Panel" Grid.Column="2" DataContext="{Binding Device}" VerticalAlignment="Top"
                                   SizeChanged="Panel_SizeChanged" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
