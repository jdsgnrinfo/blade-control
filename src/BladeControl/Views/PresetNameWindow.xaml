<Window x:Class="BladeControl.Views.PresetNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:BladeControl.UI"
        Title="{ui:T 'Save preset'}" Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource Font.Main}" Foreground="{StaticResource Brush.Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- A dark card over the window: the name, and Cancel and Save. -->
    <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="1" CornerRadius="8"
            Padding="20" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="{ui:T 'Save preset'}" />

            <TextBox x:Name="NameBox" Margin="0,16,0,0" Height="36" Padding="10,0" VerticalContentAlignment="Center"
                     FontSize="14" Foreground="{StaticResource Brush.Text}" Background="{StaticResource Brush.Tile}"
                     CaretBrush="{StaticResource Brush.Text}" SelectionBrush="{StaticResource Brush.Accent}" MaxLength="40">
                <TextBox.Template>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Back" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"
                                BorderBrush="{StaticResource Brush.Line}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </TextBox.Template>
            </TextBox>

            <TextBlock x:Name="Problem" Style="{StaticResource Text.Status}" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource ActionButton}" Content="{ui:T 'Cancel'}" IsCancel="True" Margin="0,0,8,0" />
                <Button Style="{StaticResource ActionButton}" Content="{ui:T 'Save'}" IsDefault="True" Click="Save_Click"
                        Background="{StaticResource Brush.Accent}" Foreground="{StaticResource Brush.OnAccent}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
